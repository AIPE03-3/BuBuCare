DB_USER=your-db-username
DB_PASSWORD=your-db-password
DB_HOST=your-rds-host.rds.amazonaws.com
DB_PORT=5432
DB_NAME=your-db-name
SECRET_KEY=your-secret-key-here-at-least-32-chars
# 判斷層呼叫 POST /events 用的機器驗證 key（請換成隨機長字串）
EVENT_API_KEY=change-me-to-a-long-random-string

# Kafka consumer（kafka_consumer.py 讀取）
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EVENTS_URL=http://localhost:8000/events

# AI 端讀後端裝置表用（ai/backend_devices.py 讀取）
# CAMERA_SOURCE=backend（預設）時，AI 端會用這組帳密自己登入後端拿攝影機清單。
# 用 init_db 種的管理員帳號即可；GET /devices 其實登入即可，給 staff 帳號也行。
BACKEND_API_URL=http://127.0.0.1:8000
BACKEND_API_USER=A001
BACKEND_API_PASSWORD=change-me-to-the-real-password

# AI 端事件片段存檔（ai/inference_test.py 讀取，全部可不設、用預設值）
# 跌倒觸發時把「前 CLIP_PRE_SEC 秒 + 後 CLIP_POST_SEC 秒」寫成 mp4，clip_path 指向它。
# CLIP_WIDTH：緩衝幀降寬省記憶體（0＝不縮，1080p 多路會 OOM）。CLIP_DIR 預設 ai/clips。
# CLIP_S3_BUCKET：設了才上傳並讓 clip_path 帶 s3:// URI（後端只認 s3:// 才換得出可播網址）；
#   沒設就退成本地路徑，機器不需要 boto3 與 AWS 憑證也能跑，只是前端拿不到影片。
CLIP_PRE_SEC=5
CLIP_POST_SEC=5
CLIP_WIDTH=640
# CLIP_DIR=
# CLIP_S3_BUCKET=
# CLIP_S3_PREFIX=videos
# 快照（事件截圖）與片段共用 CLIP_S3_BUCKET，但走各自的 prefix，才不會混在同一層。
# 共用同一個 bucket 的多人開發環境靠這個分開，否則彼此的快照會蓋在一起。
# 本機那份 ai/snapshots/ 不受影響也不會刪 —— 二審要從那裡讀圖餵 VLM。
# SNAPSHOT_S3_PREFIX=snapshots

# 同一路相機發過一次跌倒事件後，要隔多久才可能再發第二筆（秒，預設 180）。
# 只有「ByteTrack 追蹤器起不來」那條退路在吃它；正常情況走的是每個人各一把閂鎖
#（跌倒的人站起來一段時間就自動解鎖），不受這個值影響。
# 除了冷卻到期，還要畫面先回到「非跌倒」連續 FALL_RECOVERY_FRAMES 個處理幀才會解鎖，
# 所以人一直躺著沒人處理時不會每 3 分鐘洗版一筆。驗收測試請設成 10 之類的小值。
# FALL_COOLDOWN_SEC=180

# ── AWS S3：兩組金鑰，刻意分開，不要混用 ──────────────────────────────────────
# 這是最小權限設計。搞混會讓後端也拿到寫入權限，詳見 CLAUDE.md 第三節。
#
# 【唯讀】後端簽 presigned URL 給前端播影片用（backend/core/s3.py）。只要 GetObject。
# bucket 名稱不用設，來自 AI 端傳來的 s3://bucket/key 字串。
S3_REGION=your-s3-region
ACCESS_KEY_ID=your-aws-readonly-access-key-id
SECRET_ACCESS_KEY=your-aws-readonly-secret-access-key
S3_URL_TTL=3600

# 【讀寫】AI 端上傳事件片段用（ai/inference_test.py）。要 PutObject。
# 沒設的話 inference_test.py 會 fallback 到上面那組唯讀金鑰 → 上傳 403，
# 但 clip_path 已經寫成 s3:// 發出去了 → 前端拿到壞連結。設之前先實測權限。
S3_RW_REGION=ap-northeast-1
S3_RW_ACCESS_KEY_ID=your-aws-readwrite-access-key-id
S3_RW_SECRET_ACCESS_KEY=your-aws-readwrite-secret-access-key

# 攝影機即時串流：MediaMTX 所在主機（含協定與埠號），留空代表本環境沒有串流
# 值填「實際跑 MediaMTX 那台電腦的區網 IP」，換場地/換電腦/換 Wi-Fi 都要更新
# ⚠ 雲端 VM 上的後端也要設，否則從雲端網站看時 stream_url 會回 null、前端只有灰色占位框
# ⚠ 前端若跑在 https，這裡也要改成 https://（瀏覽器不允許 https 頁面載入 http 串流）
MEDIAMTX_BASE_URL=http://192.168.1.108:8889

# 同一台 MediaMTX，AI 端看到的樣子（ai/backend_devices.py 讀）。
# 後端組給瀏覽器的是 WHEP（上面那條，走 8889）；AI 端要的是 RTSP（走 8554），
# 協定不同所以拆成兩組設定，值卻指向同一台機器。
# 後端 GET /devices 只回頻道名（cam_in / phone_a），主機位址由這裡接上：
#   rtsp://<MEDIAMTX_HOST>:<MEDIAMTX_RTSP_PORT>/<頻道名>
# 只有 CAMERA_SOURCE=backend（預設）時才會用到。
MEDIAMTX_HOST=127.0.0.1
MEDIAMTX_RTSP_PORT=8554

# ── Triton 三顆模型的位址（ai/inference_test.py 讀）────────────────────────────
# ⚠ 一定要設。程式內建預設是 8000，但 8000 在本專案被 backend 佔用了：不設的話
# 每一幀的推論都會打到 FastAPI、收到 {"detail":"Not Found"} 而靜默降級，
# 畫面照跑、FPS 照印，只是姿態偵測全程失效 —— 很難從輸出看出來。
# Triton 的 HTTP 埠實際掛在 8010（gRPC 8011、metrics 8002）。
TRITON_POSE_URL=http://127.0.0.1:8010/yolo_pose
TRITON_DETR_URL=http://127.0.0.1:8010/rt_detr
TRITON_ACT_URL=http://127.0.0.1:8010/action_transformer

# ── 偵測畫面推流：前端「即時／偵測」切換鈕的「偵測」那一半 ─────────────────
# 開了之後，AI 會把畫好框的畫面推回 MediaMTX 的偵測頻道（資料庫 stream_channel_detect，
# 例如 cam_out），前端切到「偵測」就看得到跟著人跑的姿態框。
# 未設＝不推（行為與加這個功能之前完全相同）。需要機器上有 ffmpeg。
#
# ⚠ 只影響「即時串流」畫面。事件片段與快照**刻意維持無框的原始畫面**，不受這個開關影響
#   ——警示彈窗當下有框會干擾人工確認（組長決策）。
#
# 2026-07-31 換做法：以前是 AI 端把框燒進畫面、再編一次 H.264 推回 MediaMTX 的 cam_out
# （DETECT_STREAM / DETECT_STREAM_WIDTH / DETECT_STREAM_FPS / DETECT_STREAM_FFMPEG，
# 這四個鍵已移除，連同 ai/detect_publisher.py 一起）。現在改成 AI 只送座標、
# 瀏覽器 canvas 自己疊 —— AI 端省一整條編碼，前端還能隨手關掉骨架。
# 代價：框不在影像裡，用 VLC 等外部播放器看 MediaMTX 就沒有框。
#
# 需要後端有開（座標經 POST /streams/detections 轉播），並沿用 EVENT_API_KEY 驗證。
# 不再需要 ffmpeg，也不再與 NO_RENDER=1 互斥（座標來自幾何判定，跟畫不畫圖無關）。
DETECT_BROADCAST=0
# 每 N 個處理幀送一次座標。人眼看 10~15fps 的骨架已經很順，全送只是讓後端與瀏覽器多做工。
DETECT_BROADCAST_EVERY_N=2
# 單次 POST 的逾時秒數。刻意短：轉播失敗不該拖到推論節奏。
DETECT_BROADCAST_TIMEOUT=1.0

# ── VLM 二審（ai/vlm_worker.py 與 agent/ 共用的 Ollama）───────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── agent/：LangGraph 版二審，目前 shadow 模式 ────────────────────────────────
# ⚠ 這一段跟上面不同：agent/config.py 用 load_dotenv() 把 .env 灌進 os.environ，
#   而 ai/ 那邊的 cfg() 是 dotenv_values 讀成 dict（刻意不灌，避免 DB_PASSWORD
#   跑進 AI 行程）。兩種讀法都吃這個檔，但只有 agent 這段的值會出現在 os.environ。
#
# AGENT_SHADOW=1：只把判定寫進 shadow log，不送 Kafka。
#   要 cutover 成正式二審才改 0——那等於停掉 ai/vlm_worker.py 換它上場，別順手改。
AGENT_SHADOW=1
AGENT_SHADOW_LOG_PATH=ai/agent_shadow.jsonl
AGENT_DLQ_LOG_PATH=ai/agent_dlq.jsonl

# Kafka：group_id 刻意與 vlm_worker 的 vlm-brain-cluster 不同，兩者才能併行
# 各自獨立消費同一個 topic（實測兩邊都收得到同一則訊息）。
AGENT_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AGENT_KAFKA_IN_TOPIC=nursing-home-alerts
AGENT_KAFKA_OUT_TOPIC=processed-reports
AGENT_KAFKA_GROUP_ID=agent-reviewer

# 模型：AGENT_LLM 是判斷用的純文字模型，AGENT_VLM_MODEL 是讀圖的視覺模型。
# 程式內建預設已是 ollama:qwen2.5:7b / qwen2.5vl:7b（2026-08 A/B 後拍板，見
# ai/docs/2026-08-03-vlm-ab.md），本機沒有的話會失敗——照實際 ollama list 填。
AGENT_LLM=ollama:qwen2.5:7b
AGENT_VLM_MODEL=qwen2.5vl:7b

# 圖檔來源：local＝直接讀本機目錄；s3＝從 S3 下載並快取
AGENT_IMAGE_SOURCE=local
AGENT_IMAGE_BASE_DIR=ai/snapshots
# AGENT_IMAGE_SOURCE=s3 時才需要這四個
# AGENT_S3_BUCKET=
# AGENT_S3_PREFIX=
# AGENT_S3_REGION=ap-northeast-1
# AGENT_S3_CACHE_DIR=/tmp/agent-image-cache

# ── Label Studio（MLOps 標註端，ai/inference_to_labelstudio_sdk.py 讀）────────
# 只有跑重訓迴路才需要。沒設的話該腳本會直接 fail 並印出缺哪個。
# 帳號就是你在 Label Studio 網頁上註冊的那組（USERNAME 填 email）。
LABEL_STUDIO_USERNAME=your-label-studio-account@example.com
LABEL_STUDIO_PASSWORD=your-label-studio-password
LS_PROJECT_ID=1
