DB_USER=your-db-username
DB_PASSWORD=your-db-password
DB_HOST=your-rds-host.rds.amazonaws.com
DB_PORT=5432
DB_NAME=your-db-name
SECRET_KEY=your-secret-key-here-at-least-32-chars
# 判斷層呼叫 POST /events 用的機器驗證 key（請換成隨機長字串）
EVENT_API_KEY=change-me-to-a-long-random-string

# Kafka consumer（kafka_consumer.py 讀取）
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EVENTS_URL=http://localhost:8000/events

# AI 端讀後端裝置表用（ai/backend_devices.py 讀取）
# CAMERA_SOURCE=backend（預設）時，AI 端會用這組帳密自己登入後端拿攝影機清單。
# 用 init_db 種的管理員帳號即可；GET /devices 其實登入即可，給 staff 帳號也行。
BACKEND_API_URL=http://127.0.0.1:8000
BACKEND_API_USER=A001
BACKEND_API_PASSWORD=change-me-to-the-real-password

# AI 端事件片段存檔（ai/inference_test.py 讀取，全部可不設、用預設值）
# 跌倒觸發時把「前 CLIP_PRE_SEC 秒 + 後 CLIP_POST_SEC 秒」寫成 mp4，clip_path 指向它。
# CLIP_WIDTH：緩衝幀降寬省記憶體（0＝不縮，1080p 多路會 OOM）。CLIP_DIR 預設 ai/clips。
# CLIP_S3_BUCKET：設了才上傳並讓 clip_path 帶 s3:// URI（後端只認 s3:// 才換得出可播網址）；
#   沒設就退成本地路徑，機器不需要 boto3 與 AWS 憑證也能跑，只是前端拿不到影片。
CLIP_PRE_SEC=5
CLIP_POST_SEC=5
CLIP_WIDTH=640
# CLIP_DIR=
# CLIP_S3_BUCKET=
# CLIP_S3_PREFIX=videos

# AWS S3（事件影片/截圖換發限時網址用）
# 後端實際讀取：S3_REGION / ACCESS_KEY_ID / SECRET_ACCESS_KEY / S3_URL_TTL
# bucket 名稱來自 ai端 傳來的 s3://bucket/key 字串
S3_REGION=your-s3-region
ACCESS_KEY_ID=your-aws-access-key-id
SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_URL_TTL=3600

# 攝影機即時串流：MediaMTX 所在主機（含協定與埠號），留空代表本環境沒有串流
# 值填「實際跑 MediaMTX 那台電腦的區網 IP」，換場地/換電腦/換 Wi-Fi 都要更新
# ⚠ 雲端 VM 上的後端也要設，否則從雲端網站看時 stream_url 會回 null、前端只有灰色占位框
# ⚠ 前端若跑在 https，這裡也要改成 https://（瀏覽器不允許 https 頁面載入 http 串流）
MEDIAMTX_BASE_URL=http://192.168.1.108:8889

# 同一台 MediaMTX，AI 端看到的樣子（ai/backend_devices.py 讀）。
# 後端組給瀏覽器的是 WHEP（上面那條，走 8889）；AI 端要的是 RTSP（走 8554），
# 協定不同所以拆成兩組設定，值卻指向同一台機器。
# 後端 GET /devices 只回頻道名（cam_in / phone_a），主機位址由這裡接上：
#   rtsp://<MEDIAMTX_HOST>:<MEDIAMTX_RTSP_PORT>/<頻道名>
# 只有 CAMERA_SOURCE=backend（預設）時才會用到。
MEDIAMTX_HOST=127.0.0.1
MEDIAMTX_RTSP_PORT=8554

# ── Triton 三顆模型的位址（ai/inference_test.py 讀）────────────────────────────
# ⚠ 一定要設。程式內建預設是 8000，但 8000 在本專案被 backend 佔用了：不設的話
# 每一幀的推論都會打到 FastAPI、收到 {"detail":"Not Found"} 而靜默降級，
# 畫面照跑、FPS 照印，只是姿態偵測全程失效 —— 很難從輸出看出來。
# Triton 的 HTTP 埠實際掛在 8010（gRPC 8011、metrics 8002）。
TRITON_POSE_URL=http://127.0.0.1:8010/yolo_pose
TRITON_DETR_URL=http://127.0.0.1:8010/rt_detr
TRITON_ACT_URL=http://127.0.0.1:8010/action_transformer

# ── 偵測畫面推流：前端「即時／偵測」切換鈕的「偵測」那一半 ─────────────────
# 開了之後，AI 會把畫好框的畫面推回 MediaMTX 的偵測頻道（資料庫 stream_channel_detect，
# 例如 cam_out），前端切到「偵測」就看得到跟著人跑的姿態框。
# 未設＝不推（行為與加這個功能之前完全相同）。需要機器上有 ffmpeg。
#
# ⚠ 只影響「即時串流」畫面。事件片段與快照**刻意維持無框的原始畫面**，不受這個開關影響
#   ——警示彈窗當下有框會干擾人工確認（組長決策）。
# ⚠ 與 NO_RENDER=1 互斥：那個開關會跳過畫框，等於沒有畫面可推。
DETECT_STREAM=0
DETECT_STREAM_WIDTH=640
DETECT_STREAM_FPS=15
