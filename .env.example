DB_USER=your-db-username
DB_PASSWORD=your-db-password
DB_HOST=your-rds-host.rds.amazonaws.com
DB_PORT=5432
DB_NAME=your-db-name
SECRET_KEY=your-secret-key-here-at-least-32-chars
# 判斷層呼叫 POST /events 用的機器驗證 key（請換成隨機長字串）
EVENT_API_KEY=change-me-to-a-long-random-string

# Kafka consumer（kafka_consumer.py 讀取）
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EVENTS_URL=http://localhost:8000/events

# AI 端讀後端裝置表用（ai/backend_devices.py 讀取）
# CAMERA_SOURCE=backend（預設）時，AI 端會用這組帳密自己登入後端拿攝影機清單。
# 用 init_db 種的管理員帳號即可；GET /devices 其實登入即可，給 staff 帳號也行。
BACKEND_API_URL=http://127.0.0.1:8000
BACKEND_API_USER=A001
BACKEND_API_PASSWORD=change-me-to-the-real-password

# AI 端事件片段存檔（ai/inference_test.py 讀取，全部可不設、用預設值）
# 跌倒觸發時把「前 CLIP_PRE_SEC 秒 + 後 CLIP_POST_SEC 秒」寫成 mp4，clip_path 指向它。
# CLIP_WIDTH：緩衝幀降寬省記憶體（0＝不縮，1080p 多路會 OOM）。CLIP_DIR 預設 ai/clips。
# CLIP_S3_BUCKET：設了才上傳並讓 clip_path 帶 s3:// URI（後端只認 s3:// 才換得出可播網址）；
#   沒設就退成本地路徑，機器不需要 boto3 與 AWS 憑證也能跑，只是前端拿不到影片。
CLIP_PRE_SEC=5
CLIP_POST_SEC=5
CLIP_WIDTH=640
# CLIP_DIR=
# CLIP_S3_BUCKET=
# CLIP_S3_PREFIX=videos

# AI 端潛在危險物品偵測（ai/inference_test.py 讀取，全部可不設、用預設值）
# rt_detr 看到 knife/scissors 時推一則 event_type="hazard" 的事件到前端「潛在危險」頁。
# 危險物品是「持續狀態」不是瞬間事件（刀放桌上每幀都偵測得到），故用狀態機去重：
#   連續看到 HAZARD_CONFIRM_FRAMES 次才報一次 → 連續 HAZARD_GONE_FRAMES 次沒看到才
#   判定物品移除、之後再出現可重新告警。三個值都以「detr 實際跑過的幀」計數（降頻時
#   復用快取的幀不算），故調 DETR_EVERY_N 不會連帶改變確認所需的實際秒數。
# HAZARD_CONF 比環境家具的 0.35 嚴：誤報是直接推告警吵護理師，成本高。
HAZARD_CONF=0.5
HAZARD_CONFIRM_FRAMES=5
HAZARD_GONE_FRAMES=30

# AWS S3（事件影片/截圖換發限時網址用）
# 後端實際讀取：S3_REGION / ACCESS_KEY_ID / SECRET_ACCESS_KEY / S3_URL_TTL
# bucket 名稱來自 ai端 傳來的 s3://bucket/key 字串
S3_REGION=your-s3-region
ACCESS_KEY_ID=your-aws-access-key-id
SECRET_ACCESS_KEY=your-aws-secret-access-key