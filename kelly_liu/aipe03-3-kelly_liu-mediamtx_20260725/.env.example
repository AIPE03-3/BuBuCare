# 資料庫帳號（機敏）：真實值僅放在不提交 Git 的 .env
DB_USER=your-db-username
# 資料庫密碼（高度機敏）：請勿在程式碼或範例檔填入真實密碼
DB_PASSWORD=your-db-password
# 資料庫主機名稱或 IP（機敏）：此處僅保留替代字串
DB_HOST=your-db-hostname
DB_PORT=5432
DB_NAME=your-db-name
# JWT 簽章金鑰（高度機敏）：請使用至少 32 字元的隨機字串
SECRET_KEY=your-secret-key-here-at-least-32-chars
# 判斷層呼叫 POST /events 用的機器驗證 key（請換成隨機長字串）
EVENT_API_KEY=change-me-to-a-long-random-string

# Kafka consumer（kafka_consumer.py 讀取）
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EVENTS_URL=http://localhost:8000/events

# AWS S3（事件影片/截圖換發限時網址用）
# 後端實際讀取：S3_REGION / ACCESS_KEY_ID / SECRET_ACCESS_KEY / S3_URL_TTL
# bucket 名稱來自 ai端 傳來的 s3://bucket/key 字串
S3_REGION=your-s3-region
ACCESS_KEY_ID=your-aws-access-key-id
SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_URL_TTL=3600

# MediaMTX 即時串流（真實值只放 .env，不提交版本控制）
# 攝影機登入帳號（機敏）
CAMERA_USER=change-me
# 攝影機登入密碼（高度機敏）
CAMERA_PASS=change-me
# 攝影機主機名稱或 IP（機敏）
CAMERA_HOST=your-camera-hostname
# 攝影機 RTSP 連接埠及串流路徑
CAMERA_RTSP_PORT=554
CAMERA_STREAM_PATH=stream2
STREAM_TOKEN_EXPIRE_SECONDS=60
# 雲端 MediaMTX 主機名稱或 IP（機敏）
CLOUD_MEDIAMTX_HOST=your-cloud-mediamtx-host
# 產生本機 TLS 憑證時使用的 MediaMTX 主機 IP（機敏）
MEDIAMTX_SERVER_IP=your-mediamtx-server-ip
# MediaMTX 推流帳號與密碼（機敏）
MEDIAMTX_PUBLISH_USER=change-me
MEDIAMTX_PUBLISH_PASS=change-me
