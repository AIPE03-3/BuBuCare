name: "rt_detr_onnx"
platform: "onnxruntime_onnx"
max_batch_size: 0

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 1, 3, 640, 640 ]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [ 1, 300, 6 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

# 明確鎖版，不要改成隱式載最大版本號（理由見 triton_repo/README.md 的事故記錄：
# rt_detr 踩過一次，整台 server 起不來）。model_deployment_agent.py 部署新版時會改這個數字。
#
# ⚠️ **鎖的版本號一定要是「每台機器都拿得到」的那一版。**
#    權重（ai/triton_repo/*/[0-9]*/）不進版控，所以這裡鎖 v2 而別人只有 1/ 的話，
#    對方 pull 下去就是該模型 UNAVAILABLE、explicit 模式一顆倒全倒。
#    要部署新版就讓部署腳本改「自己機器上的 model repository」，不要提交上來。
version_policy: { specific { versions: [ 1 ] } }
