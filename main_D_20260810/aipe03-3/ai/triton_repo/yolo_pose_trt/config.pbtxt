name: "yolo_pose_trt"
platform: "tensorrt_plan"
max_batch_size: 1

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 3, 640, 640 ]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [ 56, 8400 ]
  }
]

instance_group [
  {
    kind: KIND_GPU
    # Two FP16 execution contexts keep four 10 FPS inputs off the Triton queue
    # without the extra memory/context overhead of one instance per camera.
    count: 2
  }
]
