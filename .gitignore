# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
fulilian.db
.pytest_cache/
*.pyc

# Virtual environments
.venv

# Environment variables (contains secrets)
.env

# 忽略所有官方與時序的模型權重檔（防止大檔案弄爆 GitHub）
*.pt
*.pth

# 執行時產生的 log（ClearML agent、訓練紀錄等機器產物）
*.log
.clearml-logs-final/

# 忽略作業系統暫存雜訊
.DS_Store
Thumbs.db

# 個人工具檔（skill / 專案說明 / 設定）
.claude/
CLAUDE.md
.vscode/

# 本機 Docker 版本覆蓋（只為了繞開個人環境的相容性問題，不影響 docker-compose.yml 主檔）
docker-compose.override.yml

gcp_vm_environment/.env

# =========================================================================
# 機器產物與大檔：一律不進 repo
# 起因：這些路徑長期是 untracked，任何人跑 `git add -A` 就會全吃進來（約 1.1GB），
# 其中 test4.mp4 有 344MB、超過 GitHub 100MB 硬上限，commit 後推不上去還得改寫歷史。
# =========================================================================

# Triton model_repository：只有 config.pbtxt / README.md 進 repo，模型版本目錄
#（1/、2/、3/…）裡的 model.onnx 由 `python ai/export_models.py` 重建。
# run_triton.sh 的註解本來就這樣寫，只是先前漏了對應的 ignore 規則。
ai/triton_repo/*/[0-9]*/
*.onnx

# 影片：預設全擋，只放行前端的示範片。
# test4.mp4 是 4.9 分鐘的 FPS 量測長片（344MB），要用請另外取得、不進版控。
# 新增影片前先想清楚大小；要進 repo 就在這裡加一條 `!` 白名單。
#
# ai/test_demo/test1~3.mp4 曾在白名單裡，2026-07-30 隨檔案刪除一併移除：
# 那三支是舊的剪接長片（一支混多段跌倒與正常），batch_eval.py 的
# SKIP_PREFIXES=("test",) 本來就跳過它們，不適合用來評估。
# 評估素材現在一律走 ai/train/dataset/videos/（CAUCAFall，同樣不進版控）。
*.mp4
!frontend/public/videos/fall-demo.mp4

# inference_test 觸發事件時寫入的證據快照（執行時產物）
ai/snapshots/

# =========================================================================
# AcT 重訓資料集（ai/train/dataset/）
# 判準：能用腳本重跑產生的就不進版控，人工產出的一定要進。
# =========================================================================
# 影片本體已被上面的 *.mp4 擋掉（187MB）。以下是機器產物，重跑即可重建。
# 注意：gitignore 不支援行尾註解，說明一律另起一行（這裡踩過一次）。
#
# 逐幀 pose 特徵，跑 ai/train/extract_features.py 重建
ai/train/dataset/features/
# 標註校正用的對照圖（23MB），跑 ai/train/review_labels.py 重建
ai/train/dataset/labels_review/
# 標註初稿；內容已合併進 labels/，留著只會造成兩份不同步（實際踩過）
ai/train/dataset/labels_draft/
#
# ⚠ ai/train/dataset/labels/ **要進版控**——那是人工逐支看影片標出來的跌落區間，
#   重跑任何腳本都產不出來，弄丟就要再花數小時。它只有 200KB。

# inference_test 觸發事件時寫入的前後 N 秒事件片段（執行時產物，CLIP_DIR 可改）
ai/clips/

# local_pose_eval.py 產出的標註圖／影片（執行時產物，--out 可改）
ai/pose_eval_out/

# ultralytics 訓練/驗證輸出
runs/

# 主動學習資料集（重訓用的圖與標註，機器產物）
ai/active_learning_dataset/

# agent shadow 模式的執行時產物：判定記錄與壞訊息 DLQ（JSON lines，一次跑就長好幾 MB）
ai/agent_shadow.jsonl
ai/agent_dlq.jsonl

# ⚠️ ClearML server 設定：apiserver.conf 內含明文預設密碼，不可進 repo
ai/clearml_server_config/

# 編輯/轉檔備份檔（如 config.pbtxt.onnx.bak）
*.bak