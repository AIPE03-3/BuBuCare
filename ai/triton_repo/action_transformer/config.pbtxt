name: "action_transformer"
platform: "onnxruntime_onnx"
max_batch_size: 0

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 1, 30, 34 ]
  }
]

output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [ 1, 2 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]
